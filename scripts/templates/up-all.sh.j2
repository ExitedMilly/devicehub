#!/bin/bash
# up-all.sh — bring up all instances sequentially.
# AUTO-GENERATED from instances.yaml. Do not edit by hand.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"

# Load host-specific env if available
if [ -f "$REPO_ROOT/scripts/instances.local.env" ]; then
    set -a
    source "$REPO_ROOT/scripts/instances.local.env"
    set +a
fi

# Run host preflight
"$REPO_ROOT/scripts/host-setup.sh" || {
    echo "[up-all] Host preflight failed"
    exit 1
}

{% for instance in instances %}
echo "================================================"
echo "[up-all] Bringing up: {{ instance.name }}"
echo "================================================"
"$SCRIPT_DIR/up-{{ instance.name }}.sh"

{% endfor %}
echo "================================================"
echo "[up-all] Reloading nginx routing map..."
echo "================================================"
docker exec devicehub-nginx nginx -s reload 2>&1 || \
    echo "[up-all] WARN: nginx reload failed — verify devicehub-nginx is running"
echo "================================================"
echo "[up-all] All {{ instances|length }} instances brought up."
echo "================================================"
