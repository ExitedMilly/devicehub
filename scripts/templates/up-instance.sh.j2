#!/bin/bash
# up-instance.sh — bring up a single instance.
# AUTO-GENERATED from instances.yaml. Do not edit by hand.
# Generated for: {{ instance.name }}

set -euo pipefail

# Load host-specific env (BACKUPS_DIR is already baked in by generator,
# but STF_SECRET and AUTH_REQUIRED are runtime-overridable)
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/../.." && pwd)"
if [ -f "$REPO_ROOT/scripts/instances.local.env" ]; then
    set -a
    source "$REPO_ROOT/scripts/instances.local.env"
    set +a
fi


readonly EMULATOR_NAME="emulator-{{ instance.name }}"
readonly CAPTURE_NAME="audio-capture-mgr-{{ instance.name }}"
readonly TOKEN_FILE="$HOME/caller/console-tokens/${EMULATOR_NAME}"

# console auth-token for the emulator console (telnet) transport used by the
# network module — one shared file mounted into BOTH the emulator and the
# capture-mgr. Stable across restarts; create-if-missing; never deleted on down.
mkdir -p "$(dirname "$TOKEN_FILE")"
if [ ! -s "$TOKEN_FILE" ]; then
    printf '%s' "$(openssl rand -hex 8)" > "$TOKEN_FILE"
fi
chmod 666 "$TOKEN_FILE"

# IPv6-side network: emulator needs a non-loopback IPv6, else modem_simulator
# can't connect guest<->modem over ::1 (getaddrinfo rejects loopback-only IPv6).
docker network create --ipv6 --subnet fd00:1::/64 --subnet 172.31.255.0/24 ipv6side 2>/dev/null || true

{% set emu_image = instance.emulator_image or defaults.emulator_image %}
{# Single-quote EMULATOR_ADDITIONAL_ARGS only when netsim Wi-Fi is set (its value
   needs inner double quotes); otherwise keep the plain double-quoted form. #}
{% set eaa_q = "'" if instance.wifi_ssid else '"' %}
{% if emu_image == 'orchid-emulator:op' %}
# Build the operator-identity emulator image if missing (idempotent). Behaves
# like stock budtmo unless OP_* env is set on the emulator run below.
docker image inspect orchid-emulator:op >/dev/null 2>&1 || \
    docker build -t orchid-emulator:op "$REPO_ROOT/docker/emulator-operator"
{% elif emu_image == 'orchid-emulator:op-v2' %}
# op-v2 = budtmo 36.6 (digest-pinned) + shlex transport fix + op-shim. Needed for
# netsim Wi-Fi. Build from Dockerfile.v2 if missing (idempotent).
docker image inspect orchid-emulator:op-v2 >/dev/null 2>&1 || \
    docker build -f "$REPO_ROOT/docker/emulator-operator/Dockerfile.v2" -t orchid-emulator:op-v2 "$REPO_ROOT/docker/emulator-operator"
{% endif %}
# Stop any previous container with the same name
docker stop "$EMULATOR_NAME" "$CAPTURE_NAME" 2>/dev/null || true
docker rm   "$EMULATOR_NAME" "$CAPTURE_NAME" 2>/dev/null || true

mkdir -p "{{ env.BACKUPS_DIR }}"
chmod 777 "{{ env.BACKUPS_DIR }}" 2>/dev/null || true

echo "[{{ instance.name }}] Starting capture-mgr..."
docker run -d \
    --name "$CAPTURE_NAME" \
    --network "{{ defaults.docker_network }}" \
    --group-add video \
    -e MANAGER_PORT="{{ instance.manager_port }}" \
    -e PA_SERVER="unix:/run/pulse/shared.sock" \
    -e INSTANCE_SERIAL="{{ instance.serial }}" \
    -e PULSE_SINK_NAME="{{ instance.pulse_sink }}" \
    -e PULSE_SOURCE_NAME="{{ instance.pulse_source }}" \
    -e EMULATOR_ADB_HOST="$EMULATOR_NAME" \
    -e EMULATOR_GRPC_HOST="$EMULATOR_NAME" \
    -e CAMERA_V4L2_DEVICE="/dev/video0" \
    -e WEBRTC_PORT_MIN="{{ instance.webrtc_udp_min }}" \
    -e WEBRTC_PORT_MAX="{{ instance.webrtc_udp_max }}" \
    -e BACKUP_DIR="/backups" \
    -e LOG_PRETTY="${LOG_PRETTY:-1}" \
    -e STF_SECRET="${STF_SECRET:-nosecret}" \
    -e AUTH_REQUIRED="${AUTH_REQUIRED:-0}"{% if instance.wifi_ssid %} -e WIFI_SSID="{{ instance.wifi_ssid }}"{% if instance.wifi_password %} -e WIFI_PASSWORD="{{ instance.wifi_password }}"{% endif %}{% endif %} \
    -v "{{ defaults.pulse_volume }}:/run/pulse" \
    -v "{{ env.BACKUPS_DIR }}:/backups" \
    -v "${TOKEN_FILE}:/run/console-token:ro" \
    --device "{{ instance.v4l2_device }}:/dev/video0" \
    -p "{{ instance.manager_port }}:{{ instance.manager_port }}" \
    -p "{{ instance.webrtc_udp_min }}-{{ instance.webrtc_udp_max }}:{{ instance.webrtc_udp_min }}-{{ instance.webrtc_udp_max }}/udp" \
    --restart unless-stopped \
    "{{ defaults.capture_image }}"

echo "[{{ instance.name }}] Waiting for capture-mgr to become healthy..."
for i in $(seq 1 30); do
    STATUS=$(docker inspect "$CAPTURE_NAME" --format '{{ '{{' }}.State.Health.Status{{ '}}' }}' 2>/dev/null || echo "missing")
    case "$STATUS" in
        healthy)
            echo "[{{ instance.name }}] capture-mgr is healthy (${i}s elapsed)"
            break
            ;;
        missing)
            echo "[{{ instance.name }}] ERROR: $CAPTURE_NAME container missing. Logs:"
            docker logs "$CAPTURE_NAME" 2>&1 | tail -30
            exit 1
            ;;
        *)
            sleep 1
            ;;
    esac
    if [ "$i" = "30" ]; then
        echo "[{{ instance.name }}] ERROR: $CAPTURE_NAME not healthy after 30s (status=$STATUS). Logs:"
        docker logs "$CAPTURE_NAME" 2>&1 | tail -30
        exit 1
    fi
done

echo "[{{ instance.name }}] Starting emulator..."
docker run -d \
    --name "$EMULATOR_NAME" \
    --hostname "$EMULATOR_NAME" \
    --network "{{ defaults.docker_network }}" \
    --device /dev/kvm \
    --device "{{ instance.v4l2_device }}:/dev/video0" \
    --group-add video \
    -e EMULATOR_DEVICE="{{ defaults.emulator_device }}" \
    -e WEB_VNC=true \
    -e PULSE_SERVER="unix:/run/pulse/shared.sock" \
    -e PULSE_SINK="{{ instance.pulse_sink }}" \
    -e PULSE_SOURCE="{{ instance.pulse_source }}" \
    -e QEMU_AUDIO_DRV=pa \
    -e EMULATOR_ADDITIONAL_ARGS={{ eaa_q }}-allow-host-audio -grpc 8554 -camera-front webcam0{% if instance.wifi_ssid %} -netsim-args "--wifi {{ instance.wifi_ssid }}{% if instance.wifi_password %} {{ instance.wifi_password }}{% endif %}"{% endif %}{{ eaa_q }}{% if instance.op_mcc %} -e OP_MCC="{{ instance.op_mcc }}" -e OP_MNC="{{ instance.op_mnc }}" -e OP_NAME="{{ instance.op_name }}"{% if instance.op_name_short %} -e OP_NAME_SHORT="{{ instance.op_name_short }}"{% endif %}{% endif %} \
    -v "{{ defaults.pulse_volume }}:/run/pulse" \
    -v "${TOKEN_FILE}:/home/androidusr/.emulator_console_auth_token" \
    -p "{{ instance.vnc_port }}:6080" \
    -p "{{ instance.adb_port }}:5555" \
    --restart unless-stopped \
    "{{ emu_image }}"

# Attach the non-loopback IPv6 side network (secondary) so modem_simulator works.
# Emulator stays primary on "{{ defaults.docker_network }}" for adb/console.
docker network connect ipv6side "$EMULATOR_NAME"

echo "[{{ instance.name }}] Waiting for emulator boot (up to 2 minutes)..."
for i in $(seq 1 24); do
    if docker exec "$EMULATOR_NAME" adb shell getprop sys.boot_completed 2>/dev/null | grep -q "1"; then
        echo "[{{ instance.name }}] Emulator boot completed!"
        break
    fi
    echo "[{{ instance.name }}] ... still booting ($((i*5))s elapsed)"
    sleep 5
done

# Connect adbd from devicehub stack so the device appears in UI
if docker ps --format '{{ '{{' }}.Names{{ '}}' }}' | grep -q '^adbd$'; then
    echo "[{{ instance.name }}] Connecting adbd to $EMULATOR_NAME..."
    docker compose -f docker-compose-prod.yaml --env-file scripts/variables.env exec -T adbd \
        adb connect "${EMULATOR_NAME}:5555" 2>&1 || \
        echo "[{{ instance.name }}] WARN: adb connect failed"
fi

echo "[{{ instance.name }}] Ready:"
echo "  Manager API:   http://localhost:{{ instance.manager_port }}/api/health"
echo "  Emulator VNC:  http://localhost:{{ instance.vnc_port }}/"
echo "  ADB:           adb connect localhost:{{ instance.adb_port }}"
