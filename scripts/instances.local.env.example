# instances.local.env.example
# Copy this file to instances.local.env and adjust for your host.
# instances.local.env is gitignored.

# Required: where backups are stored on the host
BACKUPS_DIR="${HOME}/devicehub-backups"

# Optional: override defaults from instances.yaml
# CAPTURE_IMAGE="my-custom-image:latest"
# EMULATOR_IMAGE="budtmo/docker-android:emulator_14.0"

# Required if AUTH_REQUIRED=1 — same secret as STF_SECRET in scripts/variables.env
# In dev/auth-mock setup, the value matches DeviceHub's STF_SECRET (typically "nosecret")
STF_SECRET="${STF_SECRET:-nosecret}"

# Enable JWT verification for manager-api endpoints (0 = backward-compat, 1 = enforce)
# Recommend keeping at 0 until P0.6 PR 3 (ownership check) is also deployed
AUTH_REQUIRED="0"
